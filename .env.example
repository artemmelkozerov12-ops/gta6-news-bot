# Скопируй в .env и заполни (для запуска на компьютере).
# В GitHub эти значения кладутся в Settings → Secrets and variables → Actions.
# Файл .env в git НЕ попадает (он в .gitignore).

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Канал (необязательно): бот сам находит канал, когда его добавляют туда админом
TELEGRAM_CHANNEL_ID=
# Твой chat id для черновиков (напиши боту /start — он пришлёт число)
TELEGRAM_ADMIN_ID=
# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ключ Groq (бесплатно, без карты): https://console.groq.com/keys
GROQ_API_KEY=

# 1 = ничего не публиковать, карточки и тексты в out/
DRY_RUN=1

# Видео (бесплатно). Twitch: https://dev.twitch.tv/console/apps → Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube: https://console.cloud.google.com/apis/credentials → API key (YouTube Data API v3)
YOUTUBE_API_KEY=

# Дополнительные бесплатные нейросети (необязательно — больше квот):
# Второй ключ Gemini из ДРУГОГО проекта Google (свои квоты): https://aistudio.google.com/apikey
GEMINI_API_KEY_2=
# Mistral, план Experiment (бесплатно, нужен номер телефона): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# OpenRouter, модели :free (50 запросов в сутки): https://openrouter.ai/keys
OPENROUTER_API_KEY=
